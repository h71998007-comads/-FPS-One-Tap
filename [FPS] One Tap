local function updateMenuStats()
    if not subTitleLabel or not subTitleLabel.Parent then return end

    local parts = {}
    if showMenuMonitor then
        table.insert(parts, string.format("FPS: %d", currentFps))
        table.insert(parts, string.format("Ping: %dms", currentPing))
    end
    if showMenuStats then
        if currentLanguage == "EN" then
            table.insert(parts, string.format("Kills: %d  |  Deaths: %d", sessionKills, sessionDeaths))
        else
            table.insert(parts, string.format("คิล: %d  |  ตาย: %d", sessionKills, sessionDeaths))
        end
    end

    if #parts > 0 then
        subTitleLabel.Text = table.concat(parts, "  |  ")
        subTitleLabel.Visible = true
    else
        subTitleLabel.Text = ""
        subTitleLabel.Visible = false
    end
end
