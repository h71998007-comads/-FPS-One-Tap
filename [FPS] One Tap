espFolder.Parent = guiParent

local tracersList = {}

local function getEnemies()
    local enemies = {}
    local myChar = LocalPlayer.Character
    for _, model in ipairs(Workspace:GetChildren()) do
        if model:IsA("Model") and model ~= myChar then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
            if hum and hrp and hum.Health > 0 then
                table.insert(enemies, model)
            end
        end
    end
    return enemies
end

local function getTargetInFOV()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end

    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestTarget = nil
    local bestDistance = fovRadius

    for _, enemy in ipairs(getEnemies()) do
        local head = enemy:FindFirstChild("Head")
        if head then
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                if screenDist < bestDistance then
                    bestDistance = screenDist
                    bestTarget = head
                end
            end
        end
    end
    return bestTarget
end

local function getClosestEnemy()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end

    local closest = nil
    local shortestDist = math.huge
    for _, enemy in ipairs(getEnemies()) do
        local hrp = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChild("Head")
        if hrp then
            local dist = (hrp.Position - myHrp.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closest = enemy
            end
        end
    end
    return closest, shortestDist
end

local function isAimKeyPressed()
    if aimLockKey == "Always Active" or aimLockKey == "Always" then
        return true
    elseif aimLockKey == "Right Click" then
        return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    elseif aimLockKey == "Left Alt" then
        return UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt)
    elseif aimLockKey == "Left Shift" then
        return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
    elseif aimLockKey == "E" then
        return UserInputService:IsKeyDown(Enum.KeyCode.E)
    elseif aimLockKey == "Q" then
        return UserInputService:IsKeyDown(Enum.KeyCode.Q)
    elseif aimLockKey == "C" then
        return UserInputService:IsKeyDown(Enum.KeyCode.C)
    elseif aimLockKey == "X" then
        return UserInputService:IsKeyDown(Enum.KeyCode.X)
    end
    return false
end

