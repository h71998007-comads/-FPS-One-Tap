local function updateCameraFov()
    local curCam = workspace.CurrentCamera
    if not curCam then return end
    if customFovEnabled then
        if math.abs(curCam.FieldOfView - customFovValue) > 0.05 then
            fovChanging = true
            curCam.FieldOfView = customFovValue
            fovChanging = false
        end
    end
end

local function hookCameraFov()
    if fovPropConn then
        pcall(function() fovPropConn:Disconnect() end)
        fovPropConn = nil
    end
    pcall(function()
        RunService:UnbindFromRenderStep("ByBankFovLock")
    end)

    local curCam = workspace.CurrentCamera
    if not curCam then return end

    -- 1. ดักจับ PropertyChangedSignal ทันทีที่มีสคริปต์ในเกมพยายามเซ็ต FOV กลับเป็น 70-95
    fovPropConn = curCam:GetPropertyChangedSignal("FieldOfView"):Connect(function()
        if fovChanging then return end
        if customFovEnabled and math.abs(curCam.FieldOfView - customFovValue) > 0.05 then
            fovChanging = true
            curCam.FieldOfView = customFovValue
            fovChanging = false
        end
    end)

    -- 2. ผูกเข้า RenderPriority.Camera + 100 เพื่อรันหลัง Camera Script ของเกม ก่อนวาดเฟรมลงหน้าจอ
    RunService:BindToRenderStep("ByBankFovLock", Enum.RenderPriority.Camera.Value + 100, function()
        if customFovEnabled and math.abs(curCam.FieldOfView - customFovValue) > 0.05 then
            fovChanging = true
            curCam.FieldOfView = customFovValue
            fovChanging = false
        end
    end)

    if customFovEnabled then
        updateCameraFov()
    end
end

local function applyFOV(val)
    if typeof(val) == "number" then
        customFovValue = val
        if customFovEnabled then
            updateCameraFov()
        end
    end
end
_G.ByBankSetFov = applyFOV

