-- 9.4 Hook Kill Popup & Scoreboard
local lastScoreboardKills = -1
local lastKilledText = ""

local function checkGameStats()
    -- ตรวจสอบ Deathscreen เพิ่มเติม
    if not hookedDeathscreen then
        setupDeathscreenHook()
    end

    -- ตรวจสอบ Scoreboard Kills
    local kLabel = getScoreboardKillLabel()
    if kLabel then
        local currentKills = tonumber(kLabel.Text)
        if currentKills then
            if lastScoreboardKills == -1 then
                lastScoreboardKills = currentKills
            elseif currentKills > lastScoreboardKills then
                local diff = currentKills - lastScoreboardKills
                registerKill("Scoreboard", diff)
                lastScoreboardKills = currentKills
            elseif currentKills < lastScoreboardKills then
                -- Match / Round reset
                lastScoreboardKills = currentKills
            end
        end
    end

    -- ตรวจสอบ Kill Popup Notification ("Killed <Player>")
    local kTarget = getKillPopupTarget()
    if kTarget and kTarget.Text ~= "" and kTarget.Text ~= lastKilledText then
        if kTarget.Text:find("Killed") then
            lastKilledText = kTarget.Text
            registerKill("KillPopup", 1)
        end
    end
end

-- 9.5 Hook Universal Roblox leaderstats (สำหรับเกมทั่วไปเช่น Arsenal, Prison Life)
local function hookLeaderstats()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        for _, child in ipairs(ls:GetChildren()) do
            if child:IsA("ValueBase") then
                local name = child.Name:lower()
                if name:find("kill") or name:find("frag") or name:find("ko") or name == "kills" then
                    local lastVal = tonumber(child.Value) or 0
                    child.Changed:Connect(function(newVal)
                        local num = tonumber(newVal) or 0
                        if num > lastVal then
                            registerKill("Leaderstats", num - lastVal)
                        end
                        lastVal = num
                    end)
                elseif name:find("death") or name:find("wipe") or name:find("died") or name == "deaths" then
                    local lastVal = tonumber(child.Value) or 0
                    child.Changed:Connect(function(newVal)
                        local num = tonumber(newVal) or 0
                        if num > lastVal then
                            registerDeath("Leaderstats")
                        end
                        lastVal = num
                    end)
                end
            end
        end
    end
end
