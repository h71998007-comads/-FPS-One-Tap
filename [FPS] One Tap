-- 9.2 Hook Character & Humanoid (ทั้งตอนเกิดและตาย)
local function hookCharacter(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 4)
    if hum then
        if runSpeedValue > 16 then hum.WalkSpeed = runSpeedValue end
        if jumpPowerValue > 50 then hum.UseJumpPower = true; hum.JumpPower = jumpPowerValue end

        hum.Died:Connect(function()
            registerDeath("HumanoidDied")
        end)

        hum.HealthChanged:Connect(function(hp)
            if hp <= 0 then
                registerDeath("HealthZero")
            elseif hp > 0 and isPlayerDead then
                registerRespawn()
            end
        end)

        hum.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.Dead then
                registerDeath("StateDead")
            end
        end)
    end

    char.AncestryChanged:Connect(function(_, parent)
        if not parent and not isPlayerDead then
            local h = char:FindFirstChildOfClass("Humanoid")
            if h and h.Health <= 0 then
                registerDeath("CharRemovedDead")
            end
        end
    end)

    registerRespawn()
end

