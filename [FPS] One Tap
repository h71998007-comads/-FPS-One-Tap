local isPlayerDead = false
local lastDeathTimestamp = 0
local lastKillTimestamp = 0
local lastKillSources = {}

local function registerDeath(source)
    local now = tick()
    if isPlayerDead or (now - lastDeathTimestamp < 1.0) then return end
    isPlayerDead = true
    lastDeathTimestamp = now
    sessionDeaths = sessionDeaths + 1
    updateMenuStats()
end

local function registerRespawn()
    isPlayerDead = false
end

local function registerKill(source, count)
    count = count or 1
    local now = tick()
    -- ป้องกันการนับซ้ำระหว่าง Scoreboard กับ Kill Popup (Debounce: 0.6s)
    if source == "KillPopup" and (now - (lastKillSources["Scoreboard"] or 0) < 0.6) then
        return
    end
    if source == "Scoreboard" and (now - (lastKillSources["KillPopup"] or 0) < 0.6) then
        lastKillSources["Scoreboard"] = now
        return
    end
    if now - lastKillTimestamp < 0.25 then return end

    lastKillTimestamp = now
    lastKillSources[source] = now
    sessionKills = sessionKills + count
    updateMenuStats()
end

