local frameCount = 0
local lastFpsUpdate = tick()
local bottomScreenPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)

renderConn = RunService.RenderStepped:Connect(function(dt)
    -- 1. FPS & Ping Calculation (Every 0.5s)
    frameCount = frameCount + 1
    if tick() - lastFpsUpdate >= 0.5 then
        currentFps = math.floor(frameCount / (tick() - lastFpsUpdate))
        frameCount = 0
        lastFpsUpdate = tick()

        pcall(function()
            currentPing = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        updateMenuStats()
    end

    -- 2. Custom Camera FOV & Zoom Distance (Safe threshold check: ป้องกัน Event Loop ซ้ำซ้อน)
    local curCam = workspace.CurrentCamera
    if curCam and customFovEnabled then
        if math.abs(curCam.FieldOfView - customFovValue) > 0.05 then
            fovChanging = true
            curCam.FieldOfView = customFovValue
            fovChanging = false
        end
    end
    if cameraZoomEnabled then
        LocalPlayer.CameraMinZoomDistance = cameraZoomDistance
        LocalPlayer.CameraMaxZoomDistance = cameraZoomDistance
    end

    -- 3. Kill & Death Tracking (Polls UI scoreboard, deathscreen, and popups)
    checkGameStats()

    local enemies = getEnemies()
    bottomScreenPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)

    -- 4. Hitbox Expander
    if hitboxEnabled then
        for _, enemy in ipairs(enemies) do
            local head = enemy:FindFirstChild("Head")
            if head then
                head.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                head.Transparency = 0.5
                head.CanCollide = false
            end
        end
    end

    local activeEnemies = {}
    for _, enemy in ipairs(enemies) do
        activeEnemies[enemy] = true
    end

    -- 5. ESP (Box or Chams)
    if espEnabled then
        for _, enemy in ipairs(enemies) do
            local hrp = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChild("Torso") or enemy:FindFirstChild("Head")
            if hrp then
                if espStyle == "Box" then
                    local hl = espFolder:FindFirstChild(enemy.Name .. "_HL")
                    if hl then hl:Destroy() end

                    local box = espFolder:FindFirstChild(enemy.Name .. "_Box")
                    if not box then
                        box = Instance.new("BillboardGui")
                        box.Name = enemy.Name .. "_Box"
                        box.Adornee = hrp
                        box.Size = UDim2.new(4, 0, 5.5, 0)
                        box.AlwaysOnTop = true
                        box.ResetOnSpawn = false
                        box.Parent = espFolder

                        local frame = Instance.new("Frame")
                        frame.Name = "BoxFrame"
                        frame.Size = UDim2.new(1, 0, 1, 0)
                        frame.BackgroundTransparency = 1
                        frame.BorderSizePixel = 0
                        frame.Parent = box

                        local stroke = Instance.new("UIStroke")
                        stroke.Name = "Stroke"
                        stroke.Color = espColor
                        stroke.Thickness = 1.5
                        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                        stroke.Parent = frame
                    else
                        local frame = box:FindFirstChild("BoxFrame")
                        if frame then
                            local stroke = frame:FindFirstChild("Stroke")
                            if stroke then stroke.Color = espColor end
                        end
                    end
                else
                    local box = espFolder:FindFirstChild(enemy.Name .. "_Box")
                    if box then box:Destroy() end

                    local hl = espFolder:FindFirstChild(enemy.Name .. "_HL")
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = enemy.Name .. "_HL"
                        hl.Adornee = enemy
                        hl.FillColor = espColor
                        hl.OutlineColor = espColor
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = espFolder
                    else
                        hl.FillColor = espColor
                        hl.OutlineColor = espColor
                    end
                end

                -- ESP Names & Health Bar (หลอดเลือดพร้อมตัวเลข HP ด้านหลัง)
                if espNamesEnabled then
                    local tag = espFolder:FindFirstChild(enemy.Name .. "_Tag")
                    local hum = enemy:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local maxHp = (hum.MaxHealth > 0 and hum.MaxHealth) or 100
                        local curHp = math.clamp(hum.Health, 0, maxHp)
                        local hpRatio = math.clamp(curHp / maxHp, 0, 1)
                        local hpText = string.format("%d HP", math.floor(curHp))

                        local hpColor
                        if hpRatio > 0.5 then
                            hpColor = Color3.fromRGB(255, 215, 0):Lerp(Color3.fromRGB(60, 235, 90), (hpRatio - 0.5) * 2)
                        else
                            hpColor = Color3.fromRGB(255, 55, 55):Lerp(Color3.fromRGB(255, 215, 0), hpRatio * 2)
                        end

                        if not tag then
                            tag = Instance.new("BillboardGui")
                            tag.Name = enemy.Name .. "_Tag"
                            tag.Adornee = enemy:FindFirstChild("Head") or hrp
                            tag.Size = UDim2.new(0, 140, 0, 32)
                            tag.StudsOffset = Vector3.new(0, 2.6, 0)
                            tag.AlwaysOnTop = true
                            tag.ResetOnSpawn = false
                            tag.Parent = espFolder

                            -- Name Label (บรรทัดบน)
                            local nameLabel = Instance.new("TextLabel")
                            nameLabel.Name = "NameLabel"
                            nameLabel.Size = UDim2.new(1, 0, 0, 15)
                            nameLabel.Position = UDim2.new(0, 0, 0, 0)
                            nameLabel.BackgroundTransparency = 1
                            nameLabel.Text = enemy.Name
                            nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                            nameLabel.TextStrokeTransparency = 0
                            nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                            nameLabel.Font = Enum.Font.GothamBold
                            nameLabel.TextSize = 12
                            nameLabel.Parent = tag

                            -- Health Bar Row (บรรทัดล่าง: หลอดเลือด + ตัวเลข HP ด้านหลัง)
                            local hpRow = Instance.new("Frame")
                            hpRow.Name = "HpRow"
                            hpRow.Size = UDim2.new(1, 0, 0, 12)
                            hpRow.Position = UDim2.new(0, 0, 0, 16)
                            hpRow.BackgroundTransparency = 1
                            hpRow.Parent = tag

                            local hpLayout = Instance.new("UIListLayout")
                            hpLayout.FillDirection = Enum.FillDirection.Horizontal
                            hpLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
                            hpLayout.VerticalAlignment = Enum.VerticalAlignment.Center
                            hpLayout.Padding = UDim.new(0, 6)
                            hpLayout.Parent = hpRow

                            -- กรอบพื้นหลังหลอดเลือด
                            local barBg = Instance.new("Frame")
                            barBg.Name = "BarBg"
                            barBg.Size = UDim2.new(0, 65, 0, 6)
                            barBg.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
                            barBg.BorderSizePixel = 0
                            barBg.Parent = hpRow

                            local barBgCorner = Instance.new("UICorner")
                            barBgCorner.CornerRadius = UDim.new(1, 0)
                            barBgCorner.Parent = barBg

                            local barBgStroke = Instance.new("UIStroke")
                            barBgStroke.Color = Color3.fromRGB(10, 10, 15)
                            barBgStroke.Thickness = 1
                            barBgStroke.Parent = barBg

                            -- แถบสีเลือด (ขยาย-หดตามเลือดจริง)
                            local barFill = Instance.new("Frame")
                            barFill.Name = "BarFill"
                            barFill.Size = UDim2.new(hpRatio, 0, 1, 0)
                            barFill.BackgroundColor3 = hpColor
                            barFill.BorderSizePixel = 0
                            barFill.Parent = barBg

                            local barFillCorner = Instance.new("UICorner")
                            barFillCorner.CornerRadius = UDim.new(1, 0)
                            barFillCorner.Parent = barFill

                            -- ตัวเลข HP ด้านหลังหลอดเลือด
                            local hpLabel = Instance.new("TextLabel")
                            hpLabel.Name = "HpLabel"
                            hpLabel.Size = UDim2.new(0, 48, 1, 0)
                            hpLabel.BackgroundTransparency = 1
                            hpLabel.Text = hpText
                            hpLabel.TextColor3 = hpColor
                            hpLabel.TextStrokeTransparency = 0
                            hpLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                            hpLabel.Font = Enum.Font.GothamBold
                            hpLabel.TextSize = 10
                            hpLabel.TextXAlignment = Enum.TextXAlignment.Left
                            hpLabel.Parent = hpRow
                        else
                            local hpRow = tag:FindFirstChild("HpRow")
                            if hpRow then
                                local barBg = hpRow:FindFirstChild("BarBg")
                                if barBg then
                                    local barFill = barBg:FindFirstChild("BarFill")
                                    if barFill then
                                        barFill.Size = UDim2.new(hpRatio, 0, 1, 0)
                                        barFill.BackgroundColor3 = hpColor
                                    end
                                end
                                local hpLabel = hpRow:FindFirstChild("HpLabel")
                                if hpLabel then
                                    hpLabel.Text = hpText
                                    hpLabel.TextColor3 = hpColor
                                end
                            end
                        end
                    end
                end
            end
        end

        -- Clean stale ESP instances
        for _, c in ipairs(espFolder:GetChildren()) do
            local enemyName = c.Name:gsub("_Box", ""):gsub("_HL", ""):gsub("_Tag", "")
            local targetModel = Workspace:FindFirstChild(enemyName)
            if not targetModel or not activeEnemies[targetModel] then
                c:Destroy()
            end
        end
    end

    -- 6. Tracers (Snaplines)
    if tracersEnabled then
        for _, enemy in ipairs(enemies) do
            local hrp = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChild("Head")
            if hrp then
                local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                local line = tracersList[enemy]
                if onScreen then
                    if not line then
                        pcall(function()
                            if typeof(Drawing) == "table" and Drawing.new then
                                line = Drawing.new("Line")
                                line.Thickness = 1.5
                                line.Color = tracerColor
                                line.Transparency = 0.8
                                tracersList[enemy] = line
                            end
                        end)
                    end
                    if line then
                        pcall(function()
                            line.From = bottomScreenPos
                            line.To = Vector2.new(screenPos.X, screenPos.Y)
                            line.Color = tracerColor
                            line.Visible = true
                        end)
                    end
                else
                    if line then
                        pcall(function() line.Visible = false end)
                    end
                end
            end
        end
    end

    -- 7. Clean stale Tracers
    for enemy, line in pairs(tracersList) do
        if not activeEnemies[enemy] or not tracersEnabled then
            pcall(function()
                if line then
                    line.Visible = false
                    line:Remove()
                    tracersList[enemy] = nil
                end
            end)
        end
    end

    -- 8. Camera Aimbot
    if aimbotEnabled and isAimKeyPressed() then
        local targetHead = getTargetInFOV()
        if targetHead then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(aimSmoothness, 0.05, 1))
        end
    end
end)

-- 9. Silent Aim Hook
pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if silentAimEnabled and (method == "FireServer" or method == "InvokeServer") then
            local targetHead = getTargetInFOV()
            if targetHead then
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = targetHead.Position
                    elseif typeof(v) == "CFrame" then
                        args[i] = CFrame.new(v.Position, targetHead.Position)
                    end
                end
                return oldNamecall(self, table.unpack(args))
            end
        end
        return oldNamecall(self, ...)
    end))
end)

